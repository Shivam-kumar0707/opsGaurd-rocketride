      "webRoot": "${workspaceFolder}/apps/opsguard-ui",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/apps/opsguard-ui/*",
        "webpack:///*": "*"
      }
    }
  ]
}
