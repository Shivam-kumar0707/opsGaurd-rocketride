{
	"components": [
		{
			"id": "webhook_sim",
			"provider": "webhook",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "webhook"
			},
			"ui": { "position": { "x": 20, "y": 200 } }
		},
		{
			"id": "agent_sim",
			"provider": "agent_rocketride",
			"config": {
				"instructions": [
					"Execute What-If Risk Simulation: recalculate deterministic risk score under modified feature slider values and output baseline vs simulated risk delta."
				],
				"max_waves": 5,
				"parameters": {}
			},
			"input": [
				{ "lane": "questions", "from": "webhook_sim" }
			],
			"ui": { "position": { "x": 240, "y": 200 } }
		},
		{
			"id": "llm_openai_sim",
			"provider": "llm_openai",
			"config": {
				"profile": "openai-5",
				"openai-5": {
					"apikey": "${ROCKETRIDE_OPENAI_KEY}"
				},
				"parameters": {}
			},
			"control": [
				{ "classType": "llm", "from": "agent_sim" }
			],
			"ui": { "position": { "x": 240, "y": 360 } }
		},
		{
			"id": "memory_sim",
			"provider": "memory_internal",
			"config": {
				"type": "memory_internal"
			},
			"control": [
				{ "classType": "memory", "from": "agent_sim" }
			],
			"ui": { "position": { "x": 400, "y": 360 } }
		},
		{
			"id": "response_sim",
			"provider": "response_json",
			"config": {
				"laneName": "simulationResult"
			},
			"input": [
				{ "lane": "answers", "from": "agent_sim" }
			],
			"ui": { "position": { "x": 460, "y": 200 } }
		}
	],
	"project_id": "c23f45a6-789b-01cd-ef23-456789012345",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}
