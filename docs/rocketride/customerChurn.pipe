{
	"components": [
		{
			"id": "webhook_churn",
			"provider": "webhook",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "webhook"
			},
			"ui": { "position": { "x": 20, "y": 200 } }
		},
		{
			"id": "agent_churn_1",
			"provider": "agent_rocketride",
			"config": {
				"instructions": [
					"Evaluate Customer Churn Risk signals: ARR value, usage decline %, active seat drops, support ticket escalations, and renewal proximity."
				],
				"max_waves": 8,
				"parameters": {}
			},
			"input": [
				{ "lane": "questions", "from": "webhook_churn" }
			],
			"ui": { "position": { "x": 240, "y": 200 } }
		},
		{
			"id": "llm_openai_churn",
			"provider": "llm_openai",
			"config": {
				"profile": "openai-5",
				"openai-5": {
					"apikey": "${ROCKETRIDE_OPENAI_KEY}"
				},
				"parameters": {}
			},
			"control": [
				{ "classType": "llm", "from": "agent_churn_1" }
			],
			"ui": { "position": { "x": 240, "y": 360 } }
		},
		{
			"id": "memory_churn",
			"provider": "memory_internal",
			"config": {
				"type": "memory_internal"
			},
			"control": [
				{ "classType": "memory", "from": "agent_churn_1" }
			],
			"ui": { "position": { "x": 400, "y": 360 } }
		},
		{
			"id": "response_churn",
			"provider": "response_json",
			"config": {
				"laneName": "churnRiskResult"
			},
			"input": [
				{ "lane": "answers", "from": "agent_churn_1" }
			],
			"ui": { "position": { "x": 460, "y": 200 } }
		}
	],
	"project_id": "b12e34f5-678a-90bc-de12-345678901234",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}
